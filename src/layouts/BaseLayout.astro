---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Unternehmensnachfolge im Mittelstand | G&P Management Consultants',
  description = 'G&P begleitet Unternehmensnachfolgen im Mittelstand – von der Analyse und Nachfolgersuche über Führung und Organisation bis zur erfolgreichen Übergabe.',
  ogImage = '/images/hero/hero-werkstatt.webp',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logos/gundp-logo.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="G&P Management Consultants" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Preload hero image for LCP -->
    <link
      rel="preload"
      as="image"
      href="/images/hero/hero-werkstatt.webp"
      media="(min-width: 768px)"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero/hero-werkstatt-mobile.webp"
      media="(max-width: 767px)"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'G&P Management Consultants UG',
        url: 'https://nachfolge.g-u-p.de',
        logo: 'https://www.g-u-p.de/gundp-logo.svg',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Birkenweg 6',
          postalCode: '84082',
          addressLocality: 'Laberweinting',
          addressCountry: 'DE',
        },
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Service',
        serviceType: 'Unternehmensnachfolge-Beratung',
        provider: { '@type': 'Organization', name: 'G&P Management Consultants UG' },
        areaServed: 'DE',
        audience: {
          '@type': 'Audience',
          audienceType: 'produzierende und familiengeführte mittelständische Unternehmen',
        },
      })}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-gp-white focus:text-gp-black focus:px-4 focus:py-3"
    >
      Zum Inhalt springen
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const reveals = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      reveals.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
