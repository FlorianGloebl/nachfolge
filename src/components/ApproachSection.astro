---
import { Factory, Users, ArrowLeftRight } from '@lucide/astro';
const base = import.meta.env.BASE_URL;

const pillars = [
  {
    icon: Factory,
    label: '01',
    title: 'Unternehmen',
    items: ['Geschäftsmodell', 'Organisation', 'Prozesse', 'Führung', 'Wissen', 'Abhängigkeiten', 'Entscheidungswege', 'Informelle Erfolgsmuster'],
  },
  {
    icon: Users,
    label: '02',
    title: 'Menschen',
    items: ['Erwartungen', 'Rollen', 'Ängste', 'Motive', 'Vertrauen', 'Akzeptanz', 'Kommunikation', 'Konflikte'],
  },
  {
    icon: ArrowLeftRight,
    label: '03',
    title: 'Übergang',
    items: [
      'Verantwortung schrittweise übertragen',
      'Klare Entscheidungsbefugnisse',
      'Loslassen',
      'Rollenklärung',
      'Einarbeitung',
      'Kommunikation',
      'Neue Führung stabilisieren',
      'Organisation weiterentwickeln',
    ],
  },
];
---

<section class="bg-gp-white py-24 md:py-32" id="ansatz">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="grid lg:grid-cols-2 gap-14 items-center reveal">
      <div>
        <p class="eyebrow">Unser Ansatz</p>
        <h2 class="font-display font-bold text-[26px] md:text-4xl lg:text-5xl leading-tight text-gp-black">
          Verstehen vor Verändern.
        </h2>
        <div class="mt-6 space-y-4 text-lg text-gp-black/70 leading-relaxed">
          <p>
            Bevor sich etwas verändern darf, muss verstanden sein, was das Unternehmen
            eigentlich erfolgreich macht. Nachfolgerinnen und Nachfolger stehen vor der
            Aufgabe, die <strong class="text-gp-black font-medium">informellen Erfolgsmuster</strong> ihres
            Unternehmens zu erkennen – die ungeschriebenen Routinen, Entscheidungswege und
            Beziehungen, die selten in einem Organigramm stehen, aber die eigentliche
            Kernkompetenz tragen.
          </p>
          <p>Für uns gehört dazu <strong class="text-gp-black font-medium">Höchstleistung im Sinne Gerhard Wohlands</strong>: eine Organisation, deren Zusammenarbeit und Entscheidungsfähigkeit zur Dynamik ihres Marktes passen. Für die Nachfolge heißt das: das Können der Menschen und die wirksamen Strukturen erkennen, erhalten und unter neuer Führung weiterentwickeln.</p>
          <p class="key-statement">
            Wer die gewachsenen Erfolgsmuster eines Unternehmens verändert, ohne sie zu verstehen, gefährdet dessen Leistungsfähigkeit.
          </p>
        </div>
      </div>
      <figure>
      <div class="aspect-3/2 overflow-hidden img-zoom">
        <img
          src={`${base}images/content/verstehen-nachfolge.webp`}
          alt="Ein erfahrener Mitarbeiter erläutert einer Nachfolgerin und einem Unternehmer ein Werkstück in der Produktion"
          class="h-full w-full object-cover"
          loading="lazy"
          width="1536"
          height="1024"
        />
      </div>
      <figcaption class="approach-source text-center"><a href="https://dynamikrobust.com/was-ist-eigentlich-hoechstleistung/" target="_blank" rel="noopener noreferrer">Zum Höchstleistungsverständnis nach Wohland ↗</a></figcaption>
      </figure>
    </div>
  </div>

  <div class="bg-gp-black text-white mt-24 md:mt-32 py-20 md:py-28 grain">
    <div class="gp-container founder-quote">
      <figure>
        <p class="eyebrow">Die zentrale Frage einer erfolgreichen Nachfolge</p>
        <blockquote>„Kann das Unternehmen seine Leistungsfähigkeit auch ohne den bisherigen Unternehmer erhalten – und gleichzeitig die Fähigkeit entwickeln, sich unter neuer Führung weiterzuentwickeln?“</blockquote>
        <figcaption>Florian Glöbl <span>– Geschäftsführer Glöbl &amp; Partner</span></figcaption>
      </figure>
      <div class="quote-signature" aria-label="Ehrlich. Direkt. Wirksam."><span>Ehrlich.</span><span>Direkt.</span><strong>Wirksam.</strong></div>
    </div>
  </div>

  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8 mt-24 md:mt-32">
    <div class="reveal">
      <h2 class="font-display font-bold text-[22px] sm:text-[26px] md:text-4xl lg:text-5xl leading-tight text-gp-black sm:whitespace-nowrap">
        Eine erfolgreiche Nachfolge braucht v.a. drei Dinge:
      </h2>
    </div>

    <div class="mt-14 grid md:grid-cols-3 gap-px bg-gp-black/10 border border-gp-black/10 reveal">
      {
        pillars.map((p) => (
          <div class="group relative bg-gp-white p-8 md:p-10 min-h-[420px] flex flex-col overflow-hidden">
            <span
              class="pointer-events-none absolute -top-6 -right-2 font-display font-extrabold text-gp-black/[0.05] leading-none select-none transition-colors duration-500 group-hover:text-gp-red/[0.08]"
              style="font-size:9rem"
              aria-hidden="true"
            >
              {p.label}
            </span>
            <p.icon class="relative w-8 h-8 text-gp-red" strokeWidth={1.5} />
            <span class="relative mt-6 text-sm text-gp-black/40 font-medium">{p.label}</span>
            <h3 class="relative font-display font-bold text-2xl md:text-[28px] text-gp-black mt-2 mb-6">
              {p.title}
            </h3>
            <ul class="space-y-2.5 text-gp-black/65 text-[15px] mt-auto">
              {p.items.map((item) => (
                <li class="border-t border-gp-black/10 pt-2.5 first:border-none first:pt-0">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
