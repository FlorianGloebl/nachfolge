---
const base = import.meta.env.BASE_URL;
const team = [
  {
    name: 'Florian Glöbl',
    role: 'Geschäftsführer, G&P Management Consultants',
    image: 'images/team/florian-gloebl.webp',
    text: 'Begleitet Unternehmer und Führungsteams pragmatisch und mit unternehmerischem Blick durch Wachstum, Führung und Nachfolge – mit Fokus auf klare Verantwortlichkeiten und wirksame Organisation.',
  },
  {
    name: 'Simone Heigl',
    role: 'Partner, G&P Management Consultants',
    image: 'images/team/simone-heigl.webp',
    text: 'Verbindet Führung, Kommunikation und Organisationsentwicklung mit psychologischer Tiefe – ihr Schwerpunkt ist Organisation, Führung & Nachfolge.',
  },
  {
    name: 'Kim Flores',
    role: 'Beraterin, Flores Advisory',
    image: 'images/team/kim-flores.webp',
    text: 'Begleitet M&A-Prozesse, strategische Weichenstellungen und Finanzierungsfragen – insbesondere wenn eine Nachfolge auch über einen Verkauf oder externe Investoren gelingen soll.',
  },
  {
    name: 'Michael Kasteleiner',
    role: 'Berater, Vollmer & Scheffczyk',
    image: 'images/team/michael-kasteleiner.webp',
    text: 'Über 15 Jahre Erfahrung in industrieller Führung und Lean-Transformation – begleitet als Sparringspartner Entscheider dabei, Organisationen auch für die Zeit nach der Übergabe wettbewerbsfähig aufzustellen.',
  },
  {
    name: 'Susanne Stroet',
    role: 'Beraterin, Vollmer & Scheffczyk',
    image: 'images/team/susanne-stroet.webp',
    text: 'Systemischer Coach mit Erfahrung aus Kundenbeziehungsmanagement und Organisationsentwicklung – unterstützt dabei, Silos aufzubrechen und neue Formen der Zusammenarbeit nach einem Führungswechsel zu gestalten.',
  },
];
---

<section class="bg-gp-warm-white py-24 md:py-32" id="team">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="max-w-2xl reveal">
      <h2 class="font-display font-bold text-[26px] md:text-4xl lg:text-5xl leading-tight text-gp-black">
        Nachfolge braucht mehr als eine Perspektive.
      </h2>
      <p class="mt-4 text-lg text-gp-black/60">Deshalb begleiten wir den Prozess als Team.</p>
    </div>

    <div class="mt-14 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-10 md:gap-x-8 reveal">
      {
        team.map((person) => (
          <div>
            <div class="aspect-[4/5] overflow-hidden bg-gp-grey-light">
              <img
                src={`${base}${person.image}`}
                alt={person.name}
                class="h-full w-full object-cover grayscale-[15%]"
                loading="lazy"
                width="700"
                height="860"
              />
            </div>
            <p class="mt-3 font-medium text-gp-black text-[15px]">{person.name}</p>
            <p class="text-gp-red text-[12px] font-medium uppercase tracking-wide mt-0.5">{person.role}</p>
            <p class="mt-2 text-gp-black/60 text-[13px] leading-relaxed">{person.text}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-14 max-w-2xl text-gp-black/70 leading-relaxed reveal">
      Wir begleiten Nachfolgeprozesse gemeinsam und bringen dabei unterschiedliche
      Perspektiven aus Beratung, Führung, Organisation und Veränderung zusammen.
    </p>
  </div>
</section>
