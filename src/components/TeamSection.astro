---
const base = import.meta.env.BASE_URL;
const team = [
  { name: 'Florian Glöbl', role: 'Geschäftsführer & Partner', company: 'Glöbl & Partner', image: 'florian-gloebl.webp', text: 'Begleitet Unternehmer und Führungsteams mit unternehmerischem Blick durch den Generationswechsel. Bringt Klarheit in Verantwortlichkeiten, stärkt Nachfolger und schafft eine Organisation, in der die neue Führung wirksam werden kann.' },
  { name: 'Susanne Stroet', role: 'Beraterin & Partnerin', company: 'Vollmer & Scheffczyk', image: 'susanne-stroet.webp', text: 'Schaut mit viel Gefühl auf die Menschen und die Muster ihrer Zusammenarbeit. Als systemischer Coach erkennt sie, was zwischen den Zeilen wirkt, hilft Silos aufzubrechen und begleitet Teams dabei, nach einem Führungswechsel neu zusammenzufinden.' },
  { name: 'Simone Heigl', role: 'Organisationspsychologin & Partnerin', company: 'Glöbl & Partner', image: 'simone-heigl.webp', text: 'Macht sichtbar, wo Rollen, Erwartungen und Entscheidungskompetenzen nicht zusammenpassen. Mit organisationspsychologischem Blick begleitet sie Familien, Nachfolger und Führungsteams zu klaren Vereinbarungen und einer tragfähigen Zusammenarbeit.' },
  { name: 'Kim Flores', role: 'Freie Beraterin & Partnerin', company: 'Im gemeinsamen Netzwerk', image: 'kim-flores.webp', text: 'Begleitet Menschen empathisch durch M&A-Prozesse, strategische Weichenstellungen und Finanzierungsfragen. Verbindet den Blick auf Zahlen und Transaktionen mit Gespür für die Beteiligten – gerade bei Verkauf oder externen Investoren.' },
  { name: 'Michael Kasteleiner', role: 'Berater & Partner', company: 'Vollmer & Scheffczyk', image: 'michael-kasteleiner.webp', text: 'Bringt viel Erfahrung aus industrieller Führung und Lean-Transformation mit. Er kennt die Geschichten, hat viel erlebt und bleibt auch bei schwierigen Übergängen ein ruhiger Sparringspartner. Gemeinsam mit Entscheidern hält er die Organisation wettbewerbsfähig.' },
];
---
<section class="bg-gp-warm-white" id="team">
  <div class="gp-container">
    <div class="team-heading"><p class="eyebrow">Menschen, die Sie begleiten</p><h2>Nachfolge braucht mehr als eine Perspektive.</h2><p class="section-lead">Deshalb begleiten wir den Prozess als Team und mit erfahrenen Partnern.</p></div>
    <div class="team-grid">
      {team.map(person => (
        <article class="team-person">
          <div class="team-photo img-zoom"><img src={`${base}images/team/${person.image}`} alt={person.name} loading="lazy" width="700" height="860" /></div>
          <h3>{person.name}</h3><p class="team-role">{person.role}</p><p class="team-company">{person.company}</p><p class="team-bio">{person.text}</p>
        </article>
      ))}
    </div>
    <figure class="team-quote"><blockquote><span>„Wir bringen unterschiedliche Perspektiven aus Beratung, Führung, Organisation und Veränderung ein.</span> <span>Gemeinsam sehen wir mehr – und machen daraus eine Begleitung,</span> <span>die für Sie und Ihr Unternehmen wertvoll ist.“</span></blockquote><figcaption>Unser gemeinsamer Anspruch an Ihre Nachfolge</figcaption></figure>
  </div>
</section>
