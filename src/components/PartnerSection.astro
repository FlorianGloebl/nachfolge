---
const base = import.meta.env.BASE_URL;
const gpItems = ['Organisation', 'Menschen', 'Führung', 'Suche', 'Übergabe', 'Weiterentwicklung'];
const ambergItems = ['Steuerberatung', 'Jahresabschluss', 'Unternehmensberatung', 'Rechtsformgestaltung', 'Finanzbuchhaltung', 'Gründungsberatung'];
---

<section class="bg-gp-white py-24 md:py-32" id="partner">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 lg:gap-16 items-end reveal">
      <h2 class="font-display font-bold text-[26px] md:text-4xl lg:text-5xl leading-tight text-gp-black">
        Nachfolge braucht unterschiedliche Spezialisten.
      </h2>
      <p class="text-lg text-gp-black/70 leading-relaxed">
        Bei Nachfolgethemen arbeiten G&amp;P und AmbergTax eng zusammen. Dadurch
        verbinden wir die organisatorische, menschliche und unternehmerische Gestaltung
        einer Nachfolge mit steuerlicher und wirtschaftlicher Expertise.
      </p>
    </div>

    <div class="mt-16 grid md:grid-cols-2 gap-px bg-gp-black/10 border border-gp-black/10 reveal">
      <div class="group relative overflow-hidden bg-gp-warm-white p-8 md:p-10 border-t-2 border-transparent hover:border-gp-red transition-colors duration-300">
        <img
          src={`${base}logos/gundp-logo.svg`}
          alt=""
          aria-hidden="true"
          class="pointer-events-none select-none absolute -top-10 -right-10 w-56 h-56 opacity-[0.06] transition-opacity duration-500 group-hover:opacity-[0.1]"
        />
        <img src={`${base}logos/gundp-logo.svg`} alt="G&amp;P Management Consultants" class="relative h-10 w-auto mb-8" />
        <ul class="relative space-y-2.5 text-gp-black/70 text-[15px]">
          {gpItems.map((item) => <li class="border-t border-gp-black/10 pt-2.5 first:border-none first:pt-0">{item}</li>)}
        </ul>
      </div>
      <div class="group relative overflow-hidden bg-gp-warm-white p-8 md:p-10 border-t-2 border-transparent hover:border-gp-red transition-colors duration-300">
        {/* AmbergTax-Logo: Nutzung von Florian Glöbl freigegeben (2026-09-07). */}
        <img
          src={`${base}logos/ambergtax-logo.png`}
          alt=""
          aria-hidden="true"
          class="pointer-events-none select-none absolute -top-10 -right-10 w-56 h-56 object-contain opacity-[0.07] transition-opacity duration-500 group-hover:opacity-[0.12]"
        />
        <img src={`${base}logos/ambergtax-logo.png`} alt="AmbergTax Steuerberatungsgesellschaft mbH" class="relative h-10 w-auto mb-8 object-contain object-left" />
        <ul class="relative space-y-2.5 text-gp-black/70 text-[15px]">
          {ambergItems.map((item) => <li class="border-t border-gp-black/10 pt-2.5 first:border-none first:pt-0">{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
