---
import { ArrowUpRight } from '@lucide/astro';
const base = import.meta.env.BASE_URL;
const partners = [
  { name: 'Glöbl & Partner', logo: 'gundp-logo.svg', href: 'https://www.g-u-p.de/', focus: 'Menschen, Führung & Organisation', text: 'Wir begleiten den Generationswechsel, entwickeln Nachfolger und gestalten den Übergang im Unternehmen.', items: ['Rollen, Erwartungen und Zusammenarbeit klären', 'Führung stärken und Verantwortung übertragen', 'Nachfolger aufbauen oder passende Personen finden'], link: 'Glöbl & Partner kennenlernen' },
  { name: 'AmbergTax', logo: 'ambergtax-logo.png', href: 'https://www.ambergtax.de/', focus: 'Steuern & wirtschaftliche Gestaltung', text: 'AmbergTax bringt steuerliche und wirtschaftliche Expertise ein – von der steuerlichen Gestaltung bis zu Fragen der Rechtsform.', items: ['Steuerliche Gestaltung der Unternehmensnachfolge', 'Rechtsformgestaltung und wirtschaftliche Beratung', 'Abstimmung mit rechtlichen Spezialisten nach Bedarf'], link: 'AmbergTax kennenlernen' },
];
---
<section class="bg-gp-white" id="partner">
  <div class="gp-container">
    <div class="partner-intro">
      <div><p class="eyebrow">Gemeinsam mit AmbergTax</p><h2>Nachfolge braucht mehrere Expertisen.</h2></div>
      <p class="section-lead">Menschen, Organisation, Steuern und rechtliche Fragen gehören bei einer Nachfolge zusammen. Deshalb arbeiten wir eng mit AmbergTax zusammen und binden für rechtliche Themen bei Bedarf die passenden Spezialisten ein. So greifen unternehmerischer Übergang und steuerliche Gestaltung ineinander.</p>
    </div>
    <div class="partner-cards">
      {partners.map(partner => (
        <a class="partner-card" href={partner.href} target="_blank" rel="noopener noreferrer" aria-label={partner.link + ' (öffnet in neuem Tab)'}>
          <div class="partner-logo-row"><img src={`${base}logos/${partner.logo}`} alt={partner.name} loading="lazy" /><ArrowUpRight size={26} aria-hidden="true" /></div>
          <h3>{partner.focus}</h3><p>{partner.text}</p>
          <ul class="editorial-list">{partner.items.map(item => <li>{item}</li>)}</ul>
          <span class="partner-link">{partner.link} <ArrowUpRight size={17} aria-hidden="true" /></span>
        </a>
      ))}
    </div>
  </div>
</section>
