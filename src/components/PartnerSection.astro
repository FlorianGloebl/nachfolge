---
const gpItems = ['Organisation', 'Menschen', 'Führung', 'Suche', 'Übergabe', 'Weiterentwicklung'];
---

<section class="bg-gp-white py-24 md:py-32" id="partner">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="max-w-2xl reveal">
      <h2 class="font-display font-bold text-[26px] md:text-4xl lg:text-5xl leading-tight text-gp-black">
        Nachfolge braucht unterschiedliche Spezialisten.
      </h2>
      <p class="mt-6 text-lg text-gp-black/70 leading-relaxed">
        Bei Nachfolgethemen arbeiten G&amp;P und AmbergTax eng zusammen. Dadurch
        verbinden wir die organisatorische, menschliche und unternehmerische Gestaltung
        einer Nachfolge mit steuerlicher und wirtschaftlicher Expertise.
      </p>
    </div>

    <div class="mt-16 grid md:grid-cols-2 gap-px bg-gp-black/10 border border-gp-black/10 reveal">
      <div class="bg-gp-warm-white p-8 md:p-10">
        <img src="/logos/gundp-logo.svg" alt="G&amp;P Management Consultants" class="h-9 w-auto mb-8" />
        <ul class="space-y-2.5 text-gp-black/70 text-[15px]">
          {gpItems.map((item) => <li class="border-t border-gp-black/10 pt-2.5 first:border-none first:pt-0">{item}</li>)}
        </ul>
      </div>
      <div class="bg-gp-warm-white p-8 md:p-10">
        {/* AmbergTax-Logo: Nutzung von Florian Glöbl freigegeben (2026-09-07). */}
        <img src="/logos/ambergtax-logo.png" alt="AmbergTax Steuerberatungsgesellschaft mbH" class="h-9 w-auto mb-8 object-contain object-left" />
        <p class="text-gp-black/70 text-[15px] leading-relaxed">
          Steuerliche Beratung und wirtschaftliche Expertise rund um die
          Unternehmensnachfolge – als eingespielter Partner an der Seite von G&amp;P.
        </p>
      </div>
    </div>
  </div>
</section>
