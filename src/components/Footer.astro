---
import { Mail, Phone, MapPin, ArrowUpRight } from '@lucide/astro';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: '#ansatz', label: 'Unser Ansatz' },
  { href: '#nachfolger-finden', label: 'Nachfolger finden' },
  { href: '#ablauf', label: 'Ablauf' },
  { href: '#team', label: 'Team' },
  { href: '#partner', label: 'Partner' },
  { href: '#wissen', label: 'Wissen' },
];
---

<footer class="bg-gp-black text-white/70">
  <div class="border-t-2 border-gp-red" />
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8 pt-16 pb-12 grid gap-12 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <img src={`${base}logos/gundp-logo.svg`} alt="G&amp;P Management Consultants" class="h-10 w-auto brightness-0 invert mb-5" />
      <p class="text-[15px] leading-relaxed max-w-xs text-white/60">
        Ehrlich. Direkt. Wirksam. G&amp;P begleitet Unternehmensnachfolgen im Mittelstand –
        von der Analyse bis zur erfolgreichen Übergabe.
      </p>
      <div class="mt-6 flex gap-3">
        <a
          href="https://www.linkedin.com/company/g-u-p/"
          aria-label="G&amp;P auf LinkedIn"
          class="flex items-center justify-center w-10 h-10 rounded-full border border-white/15 hover:border-gp-red hover:text-gp-red transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
          </svg>
        </a>
        <a
          href="https://www.instagram.com/gundp_gmbh/"
          aria-label="G&amp;P auf Instagram"
          class="flex items-center justify-center w-10 h-10 rounded-full border border-white/15 hover:border-gp-red hover:text-gp-red transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
    </div>

    <div class="text-sm">
      <div class="text-white/40 text-xs font-medium uppercase tracking-wide mb-4">Navigation</div>
      <ul class="space-y-2.5">
        {navLinks.map((l) => (
          <li><a href={l.href} class="text-white/70 hover:text-white transition-colors">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="text-sm">
      <div class="text-white/40 text-xs font-medium uppercase tracking-wide mb-4">Kontakt</div>
      <ul class="space-y-3">
        <li class="flex gap-2.5">
          <MapPin class="w-4 h-4 text-gp-red shrink-0 mt-0.5" strokeWidth={1.75} />
          <span class="leading-relaxed">Birkenweg 6<br />84082 Laberweinting</span>
        </li>
        <li class="flex gap-2.5 items-center">
          <Mail class="w-4 h-4 text-gp-red shrink-0" strokeWidth={1.75} />
          <a href="mailto:info@g-u-p.de" class="hover:text-white transition-colors">info@g-u-p.de</a>
        </li>
        <li class="flex gap-2.5 items-center">
          <Phone class="w-4 h-4 text-gp-red shrink-0" strokeWidth={1.75} />
          <a href="tel:+491721718875" class="hover:text-white transition-colors">+49 (0) 172 1718875</a>
        </li>
      </ul>
    </div>

    <div class="text-sm">
      <div class="text-white/40 text-xs font-medium uppercase tracking-wide mb-4">Rechtliches</div>
      <ul class="space-y-2.5">
        <li><a href={`${base}impressum/`} class="hover:text-white transition-colors">Impressum</a></li>
        <li><a href={`${base}datenschutz/`} class="hover:text-white transition-colors">Datenschutz</a></li>
      </ul>
      <a
        href="#kontakt"
        class="mt-6 inline-flex items-center gap-1.5 text-gp-red hover:text-white transition-colors font-medium"
      >
        Erstgespräch vereinbaren
        <ArrowUpRight class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-(--container-content) px-5 sm:px-8 py-5 flex flex-wrap gap-2 justify-between text-xs text-white/40">
      <span>© {year} G&amp;P Management Consultants UG</span>
      <span>Unternehmensnachfolge im Mittelstand</span>
    </div>
  </div>
</footer>
