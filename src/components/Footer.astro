---
const year = new Date().getFullYear();
---

<footer class="bg-gp-black text-white/70">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8 py-14 grid gap-10 md:grid-cols-3">
    <div>
      <img src="/logos/gundp-logo.svg" alt="G&amp;P Management Consultants" class="h-7 w-auto brightness-0 invert mb-4" />
      <p class="text-sm leading-relaxed max-w-xs">
        Ehrlich. Direkt. Wirksam. G&amp;P begleitet Unternehmensnachfolgen im Mittelstand –
        von der Analyse bis zur erfolgreichen Übergabe.
      </p>
    </div>

    <div class="text-sm">
      <div class="text-white font-medium mb-3">Kontakt</div>
      <p class="leading-relaxed">
        G&amp;P Management Consultants UG<br />
        Birkenweg 6<br />
        84082 Laberweinting
      </p>
      <p class="mt-3">
        <a href="mailto:info@g-u-p.de" class="hover:text-white transition-colors">info@g-u-p.de</a><br />
        <a href="tel:+491721718875" class="hover:text-white transition-colors">+49 (0) 172 1718875</a>
      </p>
    </div>

    <div class="text-sm">
      <div class="text-white font-medium mb-3">Rechtliches</div>
      <ul class="space-y-2">
        <li><a href="/impressum/" class="hover:text-white transition-colors">Impressum</a></li>
        <li><a href="/datenschutz/" class="hover:text-white transition-colors">Datenschutz</a></li>
      </ul>
      <div class="mt-6 flex gap-4">
        <a href="https://www.linkedin.com/company/g-u-p/" aria-label="G&amp;P auf LinkedIn" class="hover:text-white transition-colors">LinkedIn</a>
        <a href="https://www.instagram.com/gundp_gmbh/" aria-label="G&amp;P auf Instagram" class="hover:text-white transition-colors">Instagram</a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-(--container-content) px-5 sm:px-8 py-5 text-xs text-white/50">
      © {year} G&amp;P Management Consultants UG
    </div>
  </div>
</footer>
