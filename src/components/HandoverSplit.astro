---
const sides = [
  {
    label: 'Für den Übergeber',
    title: 'Loslassen, ohne das Lebenswerk aus der Hand zu geben.',
    dark: false,
    image: '/images/content/uebergeber-modern.webp',
    alt: 'Erfahrener Unternehmer im Gespräch mit einem Kollegen in der Produktion',
    lead: 'Formale Verantwortung ist am Tag der Übergabe geregelt. Die eigene Rolle danach nicht.',
    text: 'Was bleibt von der eigenen Rolle, wenn die Verantwortung nicht mehr täglich gebraucht wird? Übergeber stehen vor der Aufgabe, Sicherheit abzugeben, ohne sich selbst zu verlieren – und eine persönliche Perspektive für die Zeit nach der Übergabe zu entwickeln.',
    items: ['Rolle danach', 'Mitarbeitende schützen', 'Lebenswerk erhalten', 'Erwartungen und Ängste offen ansprechen'],
  },
  {
    label: 'Für den Nachfolger',
    title: 'Übernehmen, ohne alles umzukrempeln.',
    dark: true,
    image: '/images/content/nachfolger-modern.webp',
    alt: 'Zwei Kolleginnen und Kollegen im Austausch an einer modernen Fertigungsstation',
    lead: 'Formale Verantwortung ist am Tag der Übergabe geregelt. Vertrauen nicht.',
    text: 'Mitarbeitende, Führungskräfte und Kunden beobachten zunächst, ob die neue Führung fortsetzt, was das Unternehmen ausgemacht hat – und ob sie versteht, bevor sie verändert. Interner Widerstand hat dabei selten mit Ablehnung zu tun, sondern mit Sorge um Bewährtes und einer noch unklaren eigenen Rolle.',
    items: ['Akzeptanz gewinnen', 'Führungsmannschaft mitnehmen', 'Eigene Rolle finden', 'Respektvoll mit dem Bestehenden umgehen'],
  },
];
---

<section class="bg-gp-white">
  <div class="grid md:grid-cols-2">
    {
      sides.map((side) => (
        <div class={`reveal ${side.dark ? 'bg-gp-black text-white' : 'bg-gp-warm-white text-gp-black'}`}>
          <div class="aspect-4/3 overflow-hidden">
            <img
              src={side.image}
              alt={side.alt}
              class="h-full w-full object-cover"
              loading="lazy"
              width="1200"
              height="900"
            />
          </div>
          <div class="px-5 sm:px-8 lg:px-14 py-14 md:py-16">
            <div class={`max-w-md mx-auto ${side.dark ? 'md:mr-0 md:ml-auto' : 'md:ml-0 md:mr-auto'}`}>
              <p class="text-gp-red text-sm font-medium uppercase tracking-wide mb-5">{side.label}</p>
              <h3 class="font-display font-bold text-[22px] md:text-[28px] leading-snug mb-5">{side.title}</h3>
              <p class={`text-[15px] leading-relaxed mb-2 font-medium ${side.dark ? 'text-white/90' : 'text-gp-black/85'}`}>{side.lead}</p>
              <p class={`text-[15px] leading-relaxed mb-8 ${side.dark ? 'text-white/65' : 'text-gp-black/65'}`}>{side.text}</p>
              <ul class="flex flex-wrap gap-2">
                {side.items.map((item) => (
                  <li class={`text-[13px] px-3 py-1.5 rounded-full ${side.dark ? 'bg-white/10 text-white/80' : 'bg-gp-grey-light text-gp-black/70'}`}>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
