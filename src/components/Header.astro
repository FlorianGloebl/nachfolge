---
import { ArrowUpRight, Menu, X } from '@lucide/astro';
const base = import.meta.env.BASE_URL;
const navItems = [
 { href: '#problem', label: 'Orientierung' },
 { href: '#ansatz', label: 'Ansatz' },
 { href: '#ablauf', label: 'Ablauf' },
 { href: '#nachfolger-finden', label: 'Nachfolgewege' },
 { href: '#partner', label: 'Partner' },
 { href: '#team', label: 'Team' },
 { href: '#termine', label: 'Termine' },
 { href: '#kontakt', label: 'Kontakt' },
];
---
<header class="site-header">
  <div class="gp-container header-inner">
    <a href={base} class="brand" aria-label="G&P Unternehmensnachfolge – Startseite">
      <div class="brand-stack"><img class="brand-gp" src={`${base}logos/gundp-logo.svg`} alt="G&P" width="64" height="64" /><img class="brand-vs" src={`${base}logos/vollmer-scheffczyk.png`} alt="Vollmer & Scheffczyk" width="64" height="64" /></div>
      <span>UNTERNEHMENSNACHFOLGE<span>GESTALTEN</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Hauptnavigation">
      {navItems.map((item) => <a href={`${base}${item.href}`}>{item.label}</a>)}
    </nav>
    <a href={`${base}#termin`} class="gp-button header-contact">Gespräch vereinbaren <ArrowUpRight size={16} /></a>
    <button id="menu-toggle" class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu"><Menu id="icon-open" /><X id="icon-close" class="hidden" /></button>
  </div>
  <nav id="mobile-menu" class="mobile-menu hidden" aria-label="Mobile Navigation">
    {navItems.map((item) => <a href={`${base}${item.href}`}>{item.label}</a>)}
    <a href={`${base}#termin`} class="gp-button">Gespräch vereinbaren <ArrowUpRight size={16} /></a>
    <a href="https://www.g-u-p.de/">Zur G&amp;P Website ↗</a>
  </nav>
</header>
<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    document.getElementById('icon-open')?.classList.toggle('hidden', open);
    document.getElementById('icon-close')?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
  });
  window.matchMedia('(min-width: 1100px)').addEventListener('change', event => { if (event.matches) setOpen(false); });
</script>
