---
const navItems = [
  { href: '#nachfolge', label: 'Nachfolge' },
  { href: '#ansatz', label: 'Unser Ansatz' },
  { href: '#nachfolger-finden', label: 'Nachfolger finden' },
  { href: '#ablauf', label: 'Ablauf' },
  { href: '#team', label: 'Team' },
  { href: '#partner', label: 'Partner' },
  { href: '#wissen', label: 'Wissen' },
];
---

<header
  class="sticky top-0 z-40 bg-gp-black/95 backdrop-blur supports-[backdrop-filter]:bg-gp-black/90 border-b border-white/10"
>
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8 h-16 md:h-20 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="G&amp;P Management Consultants – Startseite">
      <img
        src="/logos/gundp-logo.svg"
        alt="G&amp;P Management Consultants"
        class="h-7 md:h-8 w-auto brightness-0 invert"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-sm text-white/85" aria-label="Hauptnavigation">
      {
        navItems.map((item) => (
          <a href={item.href} class="hover:text-white transition-colors">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block shrink-0">
      <a
        href="#kontakt"
        class="inline-flex items-center bg-gp-red hover:bg-gp-red-dark text-white text-sm font-medium px-5 py-2.5 transition-colors"
      >
        Erstgespräch vereinbaren
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden text-white p-2 -mr-2"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg id="icon-close" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="hidden">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="6" y1="18" x2="18" y2="6" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-white/10 bg-gp-black">
    <nav class="flex flex-col px-5 py-4 gap-1 text-white/90" aria-label="Mobile Navigation">
      {
        navItems.map((item) => (
          <a href={item.href} class="py-3 text-base border-b border-white/5 last:border-none">
            {item.label}
          </a>
        ))
      }
      <a
        href="#kontakt"
        class="mt-4 inline-flex justify-center items-center bg-gp-red text-white text-sm font-medium px-5 py-3"
      >
        Erstgespräch vereinbaren
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
