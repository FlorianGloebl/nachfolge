---
import { Clock } from '@lucide/astro';

const questions = [
  'Wer ist beteiligt – formal und emotional?',
  'Welche Rollen sind klar?',
  'Welche Ängste, Motive oder Erwartungen stehen im Raum?',
  'Wo entstehen Spannungen?',
  'Welche Gespräche wurden bisher vermieden?',
  'Welche nächsten Schritte schaffen Orientierung?',
  'Wo liegen organisatorische Risiken?',
  'Was muss vor einer Übergabe noch geklärt werden?',
];
---

<section class="bg-gp-warm-white py-24 md:py-32">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="reveal">
        <Clock class="w-9 h-9 text-gp-red mb-6" strokeWidth={1.5} />
        <h2 class="font-display font-bold text-3xl md:text-4xl leading-tight text-gp-black">
          4 Stunden Klarheit.<br /> Direkt bei Ihnen im Unternehmen.
        </h2>
        <p class="mt-6 text-lg text-gp-black/70 leading-relaxed max-w-md">
          In einer halbtägigen Erstanalyse schauen wir auf Ausgangslage, Beteiligte,
          Rollen, Spannungen und die nächsten sinnvollen Schritte.
        </p>
        <a
          href="#kontakt"
          class="mt-8 inline-flex items-center justify-center bg-gp-red hover:bg-gp-red-dark text-white font-medium px-7 py-4 transition-colors"
        >
          Kostenfreie Erstanalyse anfragen
        </a>
      </div>

      <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-4 reveal">
        {
          questions.map((q) => (
            <li class="text-[15px] text-gp-black/75 border-t border-gp-black/10 pt-3">{q}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
