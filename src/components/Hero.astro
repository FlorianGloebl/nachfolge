---
import { ArrowRight } from '@lucide/astro';
const base = import.meta.env.BASE_URL;
---

<section class="relative bg-gp-black text-white overflow-hidden" id="nachfolge">
  <div class="absolute inset-0">
    <picture>
      <source media="(max-width: 767px)" srcset={`${base}images/hero/hero-werkstatt-mobile.webp`} />
      <img
        src={`${base}images/hero/hero-werkstatt.webp`}
        alt="Team in einer modernen Produktionsumgebung im fachlichen Austausch"
        class="h-full w-full object-cover"
        fetchpriority="high"
        width="2000"
        height="1333"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-r from-gp-black via-gp-black/85 to-gp-black/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-gp-black via-transparent to-transparent"></div>
  </div>

  <div class="relative mx-auto max-w-(--container-content) px-5 sm:px-8 pt-32 pb-24 md:pt-44 md:pb-32">
    <div class="max-w-2xl">
      <p class="text-gp-red font-medium tracking-wide text-sm md:text-base uppercase mb-5 reveal">
        Unternehmensnachfolge
      </p>
      <h1 class="font-display font-extrabold text-[30px] sm:text-5xl md:text-6xl lg:text-[68px] leading-[1.2] sm:leading-[1.08] tracking-tight reveal">
        Damit weitergeht, was Sie aufgebaut haben.
      </h1>
      <p class="mt-7 text-lg md:text-xl text-white/85 max-w-xl leading-relaxed reveal">
        G&amp;P begleitet Mittelständler von der ersten Klärung über die Suche nach
        geeigneten Nachfolgern bis zur Übergabe und Weiterentwicklung.
      </p>
      <p class="mt-4 text-base md:text-lg text-white/60 max-w-xl leading-relaxed reveal">
        Nachfolge ist mehr als ein Kaufvertrag. Sie betrifft Menschen, Führung,
        Verantwortung und die Zukunft eines ganzen Unternehmens.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4 reveal">
        <a
          href="#kontakt"
          class="inline-flex items-center justify-center gap-2 bg-gp-red hover:bg-gp-red-dark text-white font-medium px-7 py-4 transition-colors"
        >
          Nachfolge besprechen
          <ArrowRight class="w-4 h-4" />
        </a>
        <a
          href="#ansatz"
          class="inline-flex items-center justify-center gap-2 border border-white/30 hover:border-white text-white font-medium px-7 py-4 transition-colors"
        >
          Unseren Ansatz ansehen
        </a>
      </div>

      <p class="mt-12 text-sm text-white/50 tracking-wide reveal">
        Organisation · Nachfolgersuche · Führung · Übergabe · M&amp;A · Coaching
      </p>
    </div>
  </div>
</section>
