---
import { ArrowRight, ArrowDown, Building2, Users, ArrowLeftRight } from '@lucide/astro';
const base = import.meta.env.BASE_URL;
const pillars = [
  { icon: Building2, title: 'Das Unternehmen vorbereiten.', text: 'Erfolgsmuster verstehen. Abhängigkeiten lösen. Nachfolgefähigkeit schaffen.', href: '#ansatz', number: '01' },
  { icon: Users, title: 'Die nächste Generation stärken.', text: 'Familiennachfolge gestalten. Nachfolger aufbauen. Bei Bedarf die passenden Menschen finden.', href: '#nachfolger-finden', number: '02' },
  { icon: ArrowLeftRight, title: 'Den Übergang wirksam gestalten.', text: 'Verantwortung übergeben. Führung stärken. Zukunft gemeinsam entwickeln.', href: '#ablauf', number: '03' },
];
---
<section class="succession-hero" id="nachfolge">
  <div class="hero-background" aria-hidden="true">
    <picture>
      <source media="(max-width: 767px)" srcset={`${base}images/hero/hero-werkstatt-mobile.webp`} />
      <img src={`${base}images/hero/hero-werkstatt.webp`} alt="" width="2000" height="1333" fetchpriority="high" />
    </picture>
  </div>
  <div class="gp-container">
    <div class="hero-intro">
      <div>
        <p class="eyebrow">Unternehmensnachfolge im Mittelstand</p>
        <h1>Damit weitergeht,<br /><span>was Sie aufgebaut haben.</span></h1>
        <p class="hero-lead">Ihr Lebenswerk. Neue Verantwortung. Eine Zukunft, die trägt.</p>
        <p class="hero-description">Wir begleiten produzierende und familiengeführte Unternehmen von der ersten Klärung bis zur gelungenen Übergabe. Unser Schwerpunkt: den Generationswechsel gestalten, Nachfolger aufbauen und die neue Führung stärken. Steht die Nachfolge noch nicht fest, helfen wir bei der Suche und prüfen gemeinsam tragfähige Alternativen.</p>

      </div>
    </div>
    <div class="hero-actions"><a href="#kontakt" class="gp-button">Nachfolge besprechen <ArrowRight size={18} /></a><a href="#ansatz" class="gp-button gp-button-secondary">Unser Ansatz <ArrowDown size={17} /></a></div>
    <div class="hero-pillars">
      {pillars.map((pillar) => (
        <a href={pillar.href} class="hero-pillar">
          <div class="pillar-top"><pillar.icon size={22} strokeWidth={1.5} /><span>{pillar.number}</span></div>
          <h2>{pillar.title}</h2><p>{pillar.text}</p>
          <ArrowRight class="pillar-arrow" size={18} />
        </a>
      ))}
    </div>
    <div class="hero-bottom"><a href="#problem">Was jetzt wichtig ist <ArrowDown size={16} /></a></div>
  </div>
</section>
