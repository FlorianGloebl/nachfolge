---
const base = import.meta.env.BASE_URL;
const items = [
  'Gespräche mit Eigentümern',
  'Interviews mit Führungskräften',
  'Produktion erleben',
  'Organisation und Entscheidungswege verstehen',
  'Kultur und informelle Regeln erkennen',
  'Abhängigkeiten sichtbar machen',
  'Schlüsselwissen erkennen',
  'Bestehende Stärken respektieren',
];
---

<section class="bg-gp-warm-white py-24 md:py-32">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="grid lg:grid-cols-2 gap-14 items-center">
      <div class="order-2 lg:order-1 aspect-3/4 max-h-[560px] overflow-hidden reveal img-zoom">
        <img
          src={`${base}images/content/produktion-weit.webp`}
          alt="Moderne Produktionshalle mit Kranbahn, in der Wertschöpfung entsteht"
          class="h-full w-full object-cover"
          loading="lazy"
          width="960"
          height="1280"
        />
      </div>
      <div class="order-1 lg:order-2 reveal">
        <h2 class="font-display font-bold text-[26px] md:text-4xl lg:text-5xl leading-tight text-gp-black">
          Wir beginnen nicht mit schönen Folien.
        </h2>
        <p class="mt-6 text-lg text-gp-black/70 leading-relaxed">
          Bevor wir über Nachfolger, Rollen und Strukturen sprechen, wollen wir das
          Unternehmen verstehen. Deshalb gehen wir dorthin, wo Wertschöpfung entsteht: ins
          Unternehmen, in die Produktion und zu den Menschen.
        </p>
        <ul class="mt-10 flex flex-wrap gap-2.5">
          {items.map((item) => (
            <li class="text-[13.5px] text-gp-black/75 bg-gp-grey-light px-3.5 py-2 rounded-full">{item}</li>
          ))}
        </ul>
        <p class="mt-8 text-gp-black/60 italic" style="font-family:var(--font-quote);">Verstehen, bevor verändert wird.</p>
      </div>
    </div>
  </div>
</section>
