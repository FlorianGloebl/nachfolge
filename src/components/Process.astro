---
import { Footprints, Flag } from '@lucide/astro';
const phases = [
  {
    n: '01',
    title: 'Ausgangslage verstehen',
    items: ['Unternehmen', 'Eigentümer', 'Familie', 'Führung', 'Organisation', 'Kultur', 'Erfolgsmuster'],
  },
  {
    n: '02',
    title: 'Ziel und Nachfolgemodell klären',
    items: ['Familiennachfolge', 'Interne Führung', 'MBO', 'MBI', 'Externer Verkauf', 'Fremdgeschäftsführung', 'Mischformen'],
  },
  {
    n: '03',
    title: 'Nachfolger aufbauen oder finden',
    items: ['Kompetenzen entwickeln', 'Sparring', 'Bei Bedarf: Profil, Suche und Auswahl'],
  },
  {
    n: '04',
    title: 'Unternehmen nachfolgefähig machen',
    items: ['Rollen', 'Prozesse', 'Zweite Führungsebene', 'Wissen', 'Entscheidungswege', 'Unternehmerabhängigkeit reduzieren'],
  },
  {
    n: '05',
    title: 'Übergabe gestalten',
    items: ['Kommunikation', 'Verantwortungsübergang', 'Rollenklärung', 'Loslassen', 'Akzeptanz', 'Einarbeitung'],
  },
  {
    n: '06',
    title: 'Neue Führung stabilisieren',
    items: ['Coaching / Sparring', 'Führungsmannschaft mitnehmen', 'Akzeptanz aufbauen', 'Zusammenarbeit gestalten', 'Führungsfragen moderieren'],
  },
  {
    n: '07',
    title: 'Weiterentwicklung',
    items: ['Strategie', 'Organisation', 'Führung', 'Operative Verbesserung', 'Organisationsentwicklung'],
  },
];

const maSteps = ['Bewertung', 'M&A-Prozess', 'Due Diligence', 'Verhandlung', 'Signing', 'Closing', 'Integration'];
---

<section class="bg-gp-white py-24 md:py-32" id="ablauf">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="process-intro reveal">
      <p class="eyebrow">Schritt für Schritt</p>
      <h2 class="font-display font-bold text-[26px] md:text-4xl lg:text-5xl leading-tight text-gp-black">
        Der Weg zu einer tragfähigen Nachfolge
      </h2>
      <p class="mt-6 text-lg text-gp-black/70 leading-relaxed">
        Sieben Stationen auf einem gemeinsamen Weg. Nicht jede Nachfolge verläuft geradlinig: Wir passen Tempo und nächste Schritte an Ihr Unternehmen und die beteiligten Menschen an.
      </p>
    </div>

    <ol class="succession-path">
      {phases.map((phase) => (
        <li class="path-station">
          <span class="path-marker">{phase.n}</span><Footprints class="path-footprints" size={24} aria-hidden="true" />
          <div class="path-content"><h3>{phase.title}</h3><p>{phase.items.join(' · ')}</p></div>
        </li>
      ))}
    </ol>
    <p class="path-destination"><Flag size={22} aria-hidden="true" /> Das Ziel: ein Unternehmen, das unter neuer Führung erfolgreich bleibt.</p>
    <aside class="transaction-panel">
      <div class="transaction-summary">
        <p class="eyebrow">Bei Verkauf oder Beteiligung</p>
        <h3>Unternehmerischer Übergang und Transaktion zusammen denken.</h3>
        <p>Je nach Mandat koordinieren wir weitere Spezialisten aus unserem Netzwerk und begleiten den M&amp;A-Prozess gemeinsam mit erfahrenen Partnern.</p>
        <a href="#partner">Unsere Zusammenarbeit mit AmbergTax <span aria-hidden="true">↗</span></a>
      </div>
      <div class="transaction-stages">
        <p class="transaction-caption">Die Transaktion im Überblick</p>
        <ol>{maSteps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}</ol>
      </div>
    </aside>
  </div>
</section>
