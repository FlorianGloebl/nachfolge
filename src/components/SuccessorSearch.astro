---
const steps = [
  { n: '01', title: 'Unternehmen verstehen' },
  { n: '02', title: 'Anforderungsprofil entwickeln' },
  { n: '03', title: 'Kandidaten identifizieren' },
  { n: '04', title: 'Gespräche & Auswahl begleiten' },
  { n: '05', title: 'Entscheidung vorbereiten' },
];

const criteria = [
  'Persönlichkeit',
  'Führung',
  'Werteverständnis',
  'Umgang mit bestehender Mannschaft',
  'Zukunftsbild',
  'Unternehmerische Eignung',
  'Kulturelle Passung',
];
---

<section class="bg-gp-charcoal text-white py-24 md:py-32" id="nachfolger-finden">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 lg:gap-16 items-end reveal">
      <h2 class="font-display font-bold text-[26px] md:text-4xl lg:text-5xl leading-tight">
        Wenn der Nachfolger noch nicht feststeht, beginnt unsere Arbeit früher.
      </h2>
      <p class="text-lg text-white/70 leading-relaxed">
        Gemeinsam entwickeln wir ein belastbares Anforderungsprofil: Welche
        unternehmerische Persönlichkeit braucht dieses Unternehmen? Welche Werte,
        Führungsqualitäten und Erfahrungen sind entscheidend? Anschließend identifizieren
        und qualifizieren wir passende Kandidatinnen und Kandidaten und begleiten den
        Auswahlprozess bis zur Entscheidung.
      </p>
    </div>

    <ol class="mt-16 grid sm:grid-cols-5 reveal">
      {
        steps.map((s, i) => (
          <li class="relative pt-8 pr-4">
            <span class="absolute left-0 top-0 h-px w-full bg-white/15" aria-hidden="true" />
            <span class={`absolute left-0 top-0 h-px bg-gp-red transition-all duration-700 ${i === 0 ? 'w-full' : 'w-0'}`} aria-hidden="true" />
            <span class="font-display font-bold text-sm text-gp-red">{s.n}</span>
            <p class="mt-3 text-[15px] text-white/85 leading-snug">{s.title}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-20 grid lg:grid-cols-[1fr_1.1fr] gap-12 items-center reveal">
      <p class="quote-mark relative font-display text-2xl md:text-[32px] leading-snug text-white">
        Der höchste Kaufpreis ist nicht automatisch die beste Nachfolge.
      </p>
      <div>
        <p class="text-white/70 mb-6">
          Nicht nur fachliche Qualifikation betrachten, sondern auch:
        </p>
        <ul class="flex flex-wrap gap-2.5">
          {criteria.map((c) => (
            <li class="text-[13.5px] text-white/85 bg-white/10 border border-white/10 px-3.5 py-2 rounded-full">{c}</li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mt-20 pt-10 border-t border-white/10 text-xl md:text-2xl font-display text-white/90 max-w-2xl reveal">
      G&amp;P kann die Suche selbst übernehmen und greift dabei auf ein großes,
      belastbares Netzwerk zurück.
    </p>
  </div>
</section>
