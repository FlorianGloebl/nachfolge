---
import { Mail, Phone, ArrowUpRight } from '@lucide/astro';
const base = import.meta.env.BASE_URL;
const calendlyUrl = 'https://calendly.com/f-gloebl-g-u-p/erstgesprach-mit-florian';
const calendlyEmbedUrl = new URL(calendlyUrl);
calendlyEmbedUrl.searchParams.set('embed_domain', Astro.url.hostname);
calendlyEmbedUrl.searchParams.set('embed_type', 'Inline');
calendlyEmbedUrl.searchParams.set('primary_color', 'c41e3a');
calendlyEmbedUrl.searchParams.set('hide_event_type_details', '1');
---
<section class="bg-gp-black text-white" id="kontakt">
  <div class="gp-container">
    <div class="contact-heading">
      <p class="eyebrow">Lassen Sie uns sprechen</p><h2>Ihre Nachfolge beginnt nicht mit einem Vertrag.<br /><span>Sondern mit einem ersten Schritt in Richtung Klarheit.</span></h2><p>Sprechen wir darüber, was Ihre Familie und Ihr Unternehmen bewegt – und welcher nächste Schritt sinnvoll ist.</p>
    </div>
    <div class="contact-booking-grid">
      <div class="contact-person">
        <img src={`${base}images/team/florian-gloebl.webp`} alt="Florian Glöbl – Ihr Ansprechpartner für die Unternehmensnachfolge" loading="lazy" width="700" height="860" />
        <div class="contact-person-details"><h3>Florian Glöbl</h3><p>Geschäftsführer Glöbl &amp; Partner</p>
        <a href="tel:+491721718875"><Phone size={18} /> +49 (0) 172 1718875</a>
        <a href="mailto:f.gloebl@g-u-p.de"><Mail size={18} /> f.gloebl@g-u-p.de</a></div>
      </div>
      <div class="booking-heading"><h3>Erstgespräch direkt über den Kalender buchen</h3><a href={calendlyUrl} target="_blank" rel="noopener noreferrer">Kalender separat öffnen <ArrowUpRight size={16} /></a></div>
    <div class="booking-section compact-booking" id="termin">
      <iframe class="calendly-frame" src={calendlyEmbedUrl.href} title="Erstgespräch mit Florian Glöbl – Termin über Calendly buchen" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      <p class="booking-note">Terminbuchung über Calendly · <a href={`${base}datenschutz/`}>Datenschutzhinweise</a></p>
    </div>
    </div>
  </div>
</section>
